# Copie para .env (que está no .gitignore) e preencha na VPS.
# NUNCA comite o .env nem cole estes valores em issue, PR ou mensagem.

# Aviso de cota e vigia da coleta, por Telegram.
# Como obter, em dois minutos:
#   1. fale com o @BotFather no Telegram -> /newbot -> copie o token
#   2. mande /start para o seu bot
#   3. abra https://api.telegram.org/bot<TOKEN>/getUpdates e copie o chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Séries históricas da ANA / HidroWeb. O cadastro é por e-mail (hidro@ana.gov.br).
ANA_USUARIO=
ANA_SENHA=
