# Copie para .env (que está no .gitignore) e preencha na VPS.
# NUNCA comite o .env nem cole estes valores em issue, PR ou mensagem.

# Aviso de cota e vigia da coleta, por Telegram.
# Como obter, em dois minutos:
#   1. fale com o @BotFather no Telegram -> /newbot -> copie o token
#   2. mande /start para o seu bot
#   3. abra https://api.telegram.org/bot<TOKEN>/getUpdates e copie o chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Séries históricas da ANA / HidroWeb. O cadastro é por e-mail (hidro@ana.gov.br).
ANA_IDENTIFICADOR=
ANA_SENHA=

# Cloudflare Access — só para scripts/autorizar_email.py (autorizar/revogar e-mails do site).
# Token: painel da Cloudflare -> My Profile -> API Tokens -> Create Token -> Custom, com UMA
# permissão de conta: "Access: Apps and Policies" — Edit. Nada de zona, DNS ou Pages.
# Account ID: painel da Cloudflare, na coluna da direita da página da conta.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Opcional: sem ele, o script acha a política pelo nome ("Autorizados" ou "Só eu").
CLOUDFLARE_ACCESS_POLICY_ID=
